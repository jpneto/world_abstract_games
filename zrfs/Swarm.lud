(define "CountSingletons"
    (count Pieces Mover
        in:(sites Around #1)
        if:(= (size Stack at:(site)) 1)
    )
)
(define "MaxCapture"
    (max
        (results
            from:(sites Occupied by:Next)
            to:0
            (if (> ("CountSingletons" (from)) (size Stack at:(from)))
                ("CountSingletons" (from))
                0
            )
        )
    )
)
(define "LargestGroupCascading"
    (max 
        (difference (sizes Group #1) (sizes Group #2))
    )         
)

//------------------------------------------------------------------------------

(game "Swarm" 
    (players 2) 
    (equipment 
        { 
        (board <Board>)
        (piece "Disc" Each)
        }
    ) 
    (rules
        (play
            (priority
                (move Select
                    (from
                        (sites Occupied by:Next)
                        if:(and
                            (> ("CountSingletons" (from)) (size Stack at:(from)))
                            (= ("CountSingletons" (from)) ("MaxCapture"))
                        )
                    )
                    (then
                        (and
                            (add
                                (to
                                    (last From)
                                    (apply 
                                        (remove (to) count:(size Stack at:(to)))
                                    )
                                )
                                count:("CountSingletons" (last From))
                                stack:True
                            )
                            (remove
                                (sites Around (last From) Own
                                    if:(= (size Stack at:(to)) 1)
                                )
                            )
                        )
                    )
                )
                (move Add (to (sites Empty))
                    count:1
                    stack:True
                )
            )
        )   
        (end
            (if 
                (no Moves Next) 
                (byScore
                    {
                    (score P1 ("LargestGroupCascading" P1 P2))
                    (score P2 ("LargestGroupCascading" P2 P1))
                    }
                )
            )
        )
    )
)

//------------------------------------------------------------------------------

(option "Board Size" <Board> args:{ <(type size)> }
    {
    (item "Hex 3" <(hex 3)> "Played on a Hex 3 board.")*
    (item "Hex 3-4" <(hex Limping 3)> "Played on a Hex 3-4 board.")
    (item "Hex 4" <(hex 4)> "Played on a Hex 4 board.")
    }
)

//------------------------------------------------------------------------------

(metadata
    (graphics
        {
        (stackType Default 0.8)
        (show Score P1 ("LargestGroupCascading" P1 P2))
        (show Score P2 ("LargestGroupCascading" P2 P1))
        }
    )
)
